# ============================================
# FLUXBUS - AMBIENTE PRODUÇÃO (COOLIFY)
# ⚠️  NUNCA commitar este arquivo com senhas reais!
# ⚠️  Copie este arquivo para .env e preencha os valores
# ============================================

# ─────────────────────────────────────────────
# 🌐 DOMÍNIOS (Coolify / Traefik)
# ─────────────────────────────────────────────
APP_DOMAIN=app.fluxbus.com.br
API_DOMAIN=api.fluxbus.com.br

# ─────────────────────────────────────────────
# 🐘 BANCO DE DADOS
# ─────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=fluxbus

# ─────────────────────────────────────────────
# 🔴 REDIS
# ─────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─────────────────────────────────────────────
# 🔐 JWT (mínimo 64 caracteres aleatórios)
# ─────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_MIN_64_CHARS_RANDOM_STRING_HERE_ABCDEFGHIJKLMNOPQRSTUVWXYZ

# ─────────────────────────────────────────────
# 📧 EMAIL
# ─────────────────────────────────────────────
MAIL_HOST=mail.z7design.com.br
MAIL_PORT=465
MAIL_USERNAME=securedguard@z7design.com.br
MAIL_PASSWORD=CHANGE_ME

# ─────────────────────────────────────────────
# 📱 WHATSAPP (Baileys)
# ─────────────────────────────────────────────
BAILEYS_ENABLED=true
BAILEYS_REST_URL=http://fluxbus-whatsapp:3333

# ─────────────────────────────────────────────
# 🐳 IMAGENS DOCKER (GitHub Container Registry)
# ─────────────────────────────────────────────
BACKEND_IMAGE=ghcr.io/SEU_USUARIO_GITHUB/fluxbus-backend:latest
FRONTEND_IMAGE=ghcr.io/SEU_USUARIO_GITHUB/fluxbus-frontend:latest

# ─────────────────────────────────────────────
# 🔧 CONFIGURAÇÕES DA APLICAÇÃO
# ─────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
VITE_API_URL=https://api.fluxbus.com.br
VITE_ENV=production
LOG_LEVEL=INFO
MAX_FILE_SIZE=10485760






























