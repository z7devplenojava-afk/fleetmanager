# ============================================
# FleetManager Agent System - Configuração
# ============================================

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/fleetmanager
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fleetmanager
DB_USER=postgres
DB_PASSWORD=postgres

# Agent Configuration
AGENT_LOG_LEVEL=INFO
AGENT_LOG_DIR=./logs
AGENT_DATA_DIR=./data

# RAG Configuration
RAG_PERSIST_DIR=./data/chromadb
RAG_COLLECTION_NAME=fleetmanager_knowledge
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Notification Configuration
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_SMTP=smtp.gmail.com
NOTIFICATION_EMAIL_PORT=587
NOTIFICATION_EMAIL_USER=
NOTIFICATION_EMAIL_PASSWORD=

NOTIFICATION_WEBHOOK_ENABLED=false
NOTIFICATION_WEBHOOK_URL=

NOTIFICATION_SLACK_ENABLED=false
NOTIFICATION_SLACK_WEBHOOK_URL=

# WhatsApp Configuration (opcional - para enviar alertas via WhatsApp)
WHATSAPP_API_URL=http://localhost:8080/api/whatsapp
WHATSAPP_API_KEY=

# Scheduler Configuration
SCHEDULER_CHECK_INTERVAL_HOURS=6
SCHEDULER_RH_CHECK_TIME=06:00
SCHEDULER_PONTO_CHECK_TIME=08:00
SCHEDULER_FINANCEIRO_CHECK_TIME=09:00
SCHEDULER_DOCUMENTOS_CHECK_TIME=10:00

# LLM Configuration (opcional - para agentes com IA integrada)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
