# Copiar para deploy/mailcow.env na VPS e preencher antes de subir o compose.
MAILCOW_HOSTNAME=mail.fluxbus.com.br
MAILCOW_TZ=America/Sao_Paulo

# Senhas fortes, geradas no servidor (nunca versionar o arquivo real).
MAILCOW_DB_PASSWORD=TROQUE_IDENTICO_NO_COMPOSE_OU_GERADO
MAILCOW_ADMIN_PASS=TROQUE_POR_SENHA_FORTE
MAILCOW_RSPAMD_PASS=TROQUE_POR_SENHA_FORTE

# Domínios gerenciados (separados por vírgula quando houver multi-tenant).
MAILCOW_DOMAINS=fluxbus.com.br

# Aplicação FleetManager: identidade transacional e credenciais da caixa comercial.
MAIL_HOST=mail.fluxbus.com.br
MAIL_PORT=587
MAIL_USERNAME=noreply@fluxbus.com.br
MAIL_FROM=noreply@fluxbus.com.br
MAIL_PASSWORD=SENHA_DA_CAIXA_NOREPLY
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true
MAIL_SSL_ENABLE=false
MAIL_SOCKET_FACTORY=
MAIL_SOCKET_FACTORY_PORT=

# E-mail comercial (usado pelo módulo de orçamentos) — substitui a senha hardcoded removida.
APP_EMAIL_COMMERCIAL_PASSWORD=SENHA_DA_CAIXA_COMERCIAL

# Sincronização IMAP automática (milliseconds).
APP_EMAIL_SYNC_INTERVAL_MS=300000
APP_EMAIL_SYNC_INITIAL_DELAY_MS=60000
