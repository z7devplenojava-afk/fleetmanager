# =============================================================================
# FluxBus PROD — FRONTEND (application separada no Coolify)
# =============================================================================
# Coolify → New Resource → Application → Git Repository
#   Base Directory : frontend
#   Dockerfile     : Dockerfile.prod
#   Port Exposed   : 80
#   Domain         : www.fluxbus.com.br
#   Health Check   : /health
#
# Build Arguments (obrigatório — Vite embute no build):
# =============================================================================

VITE_API_URL=https://api.fluxbus.com.br/api
VITE_WS_URL=wss://api.fluxbus.com.br/ws
VITE_ENVIRONMENT=production
