# =============================================================================
# FluxBus — Fleet Manager — deploy no Coolify (VPS 198.7.116.227)
# =============================================================================
#
# Painel Coolify:
#   http://198.7.116.227:8000
#   http://[2a02:c202:2196:8228::1]:8000
#
# Pastas no servidor (um ambiente por pasta):
#   PROD → /var/www/fluxbus
#   DEV  → /var/www/fluxbus/dev
#   CI   → /ci
#
# Criar pastas no VPS:
#   sudo bash deploy/scripts/setup-server-dirs.sh
#
# Detalhes: deploy/fluxbus/server-paths.example
# =============================================================================

# -----------------------------------------------------------------------------
# Domínios
# -----------------------------------------------------------------------------
# | Ambiente | Pasta servidor         | Frontend             | Backend (API)          |
# |----------|------------------------|----------------------|------------------------|
# | PROD     | /var/www/fluxbus       | www.fluxbus.com.br   | api.fluxbus.com.br     |
# | DEV      | /var/www/fluxbus/dev   | dev.fluxbus.com.br   | api.dev.fluxbus.com.br |
# | CI       | /ci                    | ci.fluxbus.com.br    | api.ci.fluxbus.com.br  |

# -----------------------------------------------------------------------------
# Arquivos por ambiente (copiar no Coolify)
# -----------------------------------------------------------------------------
# PROD: deploy/fluxbus/prod/coolify.frontend.example
#       deploy/fluxbus/prod/coolify.backend.example
# DEV:  deploy/fluxbus/dev/coolify.frontend.example
#       deploy/fluxbus/dev/coolify.backend.example
# CI:   deploy/ci/coolify.frontend.example
#       deploy/ci/coolify.backend.example

# -----------------------------------------------------------------------------
# Cloudflare — DNS (IP: 198.7.116.227 ou CNAME → fluxbus.com.br)
# -----------------------------------------------------------------------------
# Criar se ainda não existir:
#   api.fluxbus.com.br
#   api.dev.fluxbus.com.br
#   api.ci.fluxbus.com.br
#   www.fluxbus.com.br

# -----------------------------------------------------------------------------
# PASSO 1 — Primeiro acesso ao Coolify
# -----------------------------------------------------------------------------
# 1. Abra http://198.7.116.227:8000
# 2. Crie usuário admin
# 3. Adicione o servidor (localhost já vem configurado)
# 4. Crie 3 Projects: FluxBus PROD, FluxBus DEV, FluxBus CI

# -----------------------------------------------------------------------------
# PASSO 2 — Por ambiente (repita em PROD, DEV e CI)
# -----------------------------------------------------------------------------
#
# A) PostgreSQL
#    Project → + New → Database → PostgreSQL
#    Anote hostname interno (ex.: postgres-xxxxx)
#
# B) Redis
#    Project → + New → Database → Redis
#    Anote hostname interno (ex.: redis-xxxxx)
#
# C) Backend
#    + New → Application → Git → repositório fleetmanager
#    Base Directory : backend
#    Dockerfile     : Dockerfile.prod
#    Port           : 8080
#    Domain         : api.fluxbus.com.br (ou api.dev / api.ci)
#    Environment    : arquivo coolify.backend.example do ambiente
#    Volumes (host → container):
#      PROD: /var/www/fluxbus/data/uploads      → /app/uploads
#      PROD: /var/www/fluxbus/data/holerites    → /app/holerites
#      PROD: /var/www/fluxbus/data/logs         → /app/logs
#      DEV:  /var/www/fluxbus/dev/data/uploads  → /app/uploads
#      DEV:  /var/www/fluxbus/dev/data/holerites → /app/holerites
#      DEV:  /var/www/fluxbus/dev/data/logs     → /app/logs
#      CI:   /ci/data/uploads                   → /app/uploads
#      CI:   /ci/data/holerites                 → /app/holerites
#      CI:   /ci/data/logs                      → /app/logs
#    Healthcheck    : /api/health porta 8080
#
# D) Frontend
#    + New → Application → mesmo Git
#    Base Directory : frontend
#    Dockerfile     : Dockerfile.prod
#    Port           : 80
#    Domain         : www / dev / ci.fluxbus.com.br
#    Build Arguments (NÃO Environment Variables!):
#      copiar coolify.frontend.example do ambiente
#    Healthcheck    : /health porta 80
#
# E) WhatsApp (opcional)
#    Base Directory : whatsapp-service
#    Port           : 3333
#    Volume         : .../data/whatsapp-sessions → /app/sessions
#    Sem domínio público

# -----------------------------------------------------------------------------
# PASSO 3 — Cloudflare SSL
# -----------------------------------------------------------------------------
# SSL/TLS → Full (strict) após Coolify gerar certificado Let's Encrypt

# -----------------------------------------------------------------------------
# Health checks
# -----------------------------------------------------------------------------
# PROD: https://www.fluxbus.com.br/health
#       https://api.fluxbus.com.br/api/health
# DEV:  https://dev.fluxbus.com.br/health
#       https://api.dev.fluxbus.com.br/api/health
# CI:   https://ci.fluxbus.com.br/health
#       https://api.ci.fluxbus.com.br/api/health

# -----------------------------------------------------------------------------
# Debug no servidor (clone manual opcional)
# -----------------------------------------------------------------------------
# PROD: git clone <repo> /var/www/fluxbus/app
# DEV:  git clone <repo> /var/www/fluxbus/dev/app
# CI:   git clone <repo> /ci/app
# Logs backend: tail -f /var/www/fluxbus/data/logs/backend_debug.log
