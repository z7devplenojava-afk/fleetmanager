# =============================================================================
# FluxBus DEV — BACKEND (application separada no Coolify)
# =============================================================================
# Base Directory : backend
# Dockerfile     : Dockerfile.prod
# Port Exposed   : 8080
# Domain         : api.dev.fluxbus.com.br
# Health Check   : /api/health
# =============================================================================

SPRING_PROFILES_ACTIVE=prod

DB_URL=jdbc:postgresql://<HOST_POSTGRES_COOLIFY>:5432/fleetmanager_dev
DB_USERNAME=postgres
DB_PASSWORD=altere_para_senha_forte_gerada

REDIS_HOST=<HOST_REDIS_COOLIFY>
REDIS_PORT=6379
REDIS_PASSWORD=altere_para_senha_forte_gerada

JWT_SECRET=altere_para_string_aleatoria_com_pelo_menos_32_caracteres
JWT_EXPIRATION=604800000

MAIL_HOST=mail.z7design.com.br
MAIL_PORT=465
MAIL_USERNAME=securedguard@z7design.com.br
MAIL_PASSWORD=altere_senha_email
MAIL_FROM=securedguard@z7design.com.br

BAILEYS_ENABLED=true
BAILEYS_REST_URL=http://<HOST_WHATSAPP_COOLIFY>:3333
WHATSAPP_INSTANCE_KEY=fluxbus_dev

RECAPTCHA_SECRET_KEY=
N8N_ENABLED=false

JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=50.0 -XX:+UseG1GC
