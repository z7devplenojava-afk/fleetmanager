# ============================================
# FLUXBUS BACKEND - PRODUÇÃO
# Multi-stage build otimizado com Gradle
# ============================================

# ============================================
# STAGE 1: Build
# ============================================
FROM gradle:8.5-jdk17-alpine AS builder

WORKDIR /build

# Copiar arquivos de configuração do Gradle primeiro (para cache de dependências)
COPY gradle/ gradle/
COPY build.gradle settings.gradle gradlew ./

# Dar permissão de execução para o gradlew
RUN chmod +x gradlew

# Baixar dependências (ajuda a acelerar builds subsequentes)
RUN ./gradlew dependencies --no-daemon || true

# Copiar código fonte
COPY src ./src

# Build do projeto (ignora testes em produção para agilizar)
RUN ./gradlew bootJar -x test --no-daemon && \
    mv build/libs/*.jar app.jar

# ============================================
# STAGE 2: Runtime
# ============================================
FROM eclipse-temurin:17-jre-alpine AS production

LABEL maintainer="Fluxbus Team"
LABEL environment="production"
LABEL version="1.0.0"

# Instalar pacotes necessários e configurar timezone America/Sao_Paulo
RUN apk add --no-cache curl bash tzdata && \
    cp /usr/share/zoneinfo/America/Sao_Paulo /etc/localtime && \
    echo "America/Sao_Paulo" > /etc/timezone

# Criar usuário não-root por segurança
RUN addgroup -S spring && adduser -S spring -G spring

WORKDIR /app

# Copiar o executável gerado
COPY --from=builder /build/app.jar app.jar

# Criar diretórios necessários com permissão correta
RUN mkdir -p /app/holerites && \
    mkdir -p /app/uploads && \
    mkdir -p /app/logs && \
    chown -R spring:spring /app

USER spring

ENV SPRING_PROFILES_ACTIVE=prod
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/api/health || exit 1

# Otimizações da JVM para containers Docker
ENV JAVA_OPTS="-XX:+UseContainerSupport \
    -XX:MaxRAMPercentage=75.0 \
    -XX:InitialRAMPercentage=50.0 \
    -XX:+UseG1GC \
    -XX:+UseStringDeduplication \
    -Djava.security.egd=file:/dev/./urandom"

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
